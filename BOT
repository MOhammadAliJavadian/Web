        self.db = db
        self.exchange = exchange
        self.config = config
        self.last_update = 0
        self.update_interval = 5  # بروزرسانی هر 5 ثانیه

    def start(self):
        """شروع نمایش وضعیت"""
        logger.info("نمایشگر وضعیت فعال شد")
        while True:
            try:
                # بررسی زمان آخرین بروزرسانی
                current_time = time.time()
                if current_time - self.last_update >= self.update_interval:
                    self.display_status()
                    self.last_update = current_time
                # تاخیر کوتاه برای کاهش مصرف CPU
                time.sleep(1)
            except KeyboardInterrupt:
                logger.info("نمایشگر وضعیت متوقف شد")
                break
