import numpy as np
import talib
import logging

logger = logging.getLogger(__name__)


class RSI_ATR_Strategy:
    """استراتژی معاملاتی بر اساس RSI و ATR"""

    def __init__(self, config):
        """مقداردهی اولیه با تنظیمات"""
        self.config = config
        self.last_signal = None
        self.last_signal_time = 0

        # تنظیمات پیش‌فرض اگر در کانفیگ موجود نباشند
        self.rsi_period = getattr(config, 'rsi_period', 14)
        self.atr_period = getattr(config, 'atr_period', 14)
        self.ma_period = getattr(config, 'ma_period', 50)
        self.rsi_oversold = getattr(config, 'rsi_oversold', 30)
        self.rsi_overbought = getattr(config, 'rsi_overbought', 70)
        self.atr_multiplier = getattr(config, 'atr_multiplier', 2.0)
        self.risk_reward_ratio = getattr(config, 'risk_reward_ratio', 2.0)

    def calculate_indicators(self, market_data):
        """محاسبه اندیکاتورهای مورد نیاز استراتژی"""
        try:
            # استخراج داده‌های بازار
            close_prices = market_data['close']
            high_prices = market_data['high']
            low_prices = market_data['low']

            # محاسبه RSI
            rsi = talib.RSI(close_prices, timeperiod=self.rsi_period)

            # محاسبه ATR
            atr = talib.ATR(high_prices, low_prices, close_prices, timeperiod=self.atr_period)

            # محاسبه میانگین متحرک
            ma = talib.SMA(close_prices, timeperiod=self.ma_period)

            return {
                'rsi': rsi,
                'atr': atr,
                'ma': ma,
                'close': close_prices,
                'high': high_prices,
                'low': low_prices
            }
        except Exception as e:
            logger.error(f"خطا در محاسبه اندیکاتورها: {str(e)}")
            return None

    def generate_signal(self, market_data):
        """تولید سیگنال معاملاتی بر اساس استراتژی"""
        try:
            # محاسبه اندیکاتورها
            indicators = self.calculate_indicators(market_data)
            if not indicators:
                return None

            # استخراج مقادیر آخرین کندل
            current_rsi = indicators['rsi'][-1]
            current_close = indicators['close'][-1]
            current_ma = indicators['ma'][-1]
            current_atr = indicators['atr'][-1]

            # بررسی شرایط سیگنال خرید
            if (current_rsi < self.rsi_oversold and
                    current_close > current_ma and
                    current_rsi > indicators['rsi'][-2]):
                # محاسبه حد ضرر و حد سود
                stop_loss = current_close - (current_atr * self.atr_multiplier)
                take_profit = current_close + (current_atr * self.atr_multiplier * self.risk_reward_ratio)

                return {
                    'signal': 'BUY',
                    'price': current_close,
                    'stop_loss': stop_loss,
                    'take_profit': take_profit,
                    'rsi': current_rsi,
                    'atr': current_atr
                }

            # بررسی شرایط سیگنال فروش
            elif (current_rsi > self.rsi_overbought and
                  current_close < current_ma and
                  current_rsi < indicators['rsi'][-2]):
                # محاسبه حد ضرر و حد سود
                stop_loss = current_close + (current_atr * self.atr_multiplier)
                take_profit = current_close - (current_atr * self.atr_multiplier * self.risk_reward_ratio)

                return {
                    'signal': 'SELL',
                    'price': current_close,
                    'stop_loss': stop_loss,
                    'take_profit': take_profit,
                    'rsi': current_rsi,
                    'atr': current_atr
                }

            # عدم وجود سیگنال
            return {
                'signal': 'NEUTRAL',
                'price': current_close,
                'rsi': current_rsi,
                'atr': current_atr
            }
        except Exception as e:
            logger.error(f"خطا در تولید سیگنال: {str(e)}")
            return None

    def check_exit_conditions(self, trade, current_price):
        """بررسی شرایط خروج از معامله"""
        try:
            # استخراج اطلاعات معامله
            entry_price = trade['entry_price']
            stop_loss = trade['stop_loss']
            take_profit = trade['take_profit']
            side = trade['side']

            # بررسی شرایط خروج برای معاملات خرید
            if side == 'BUY':
                # بررسی حد ضرر
                if current_price <= stop_loss:
                    return {
                        'exit': True,
                        'reason': 'STOP_LOSS',
                        'price': current_price
                    }
                # بررسی حد سود
                elif current_price >= take_profit:
                    return {
                        'exit': True,
                        'reason': 'TAKE_PROFIT',
                        'price': current_price
                    }

            # بررسی شرایط خروج برای معاملات فروش
            elif side == 'SELL':
                # بررسی حد ضرر
                if current_price >= stop_loss:
                    return {
                        'exit': True,
                        'reason': 'STOP_LOSS',
                        'price': current_price
                    }
                # بررسی حد سود
                elif current_price <= take_profit:
                    return {
                        'exit': True,
                        'reason': 'TAKE_PROFIT',
                        'price': current_price
                    }

            # عدم وجود شرایط خروج
            return {
                'exit': False,
                'price': current_price
            }
        except Exception as e:
            logger.error(f"خطا در بررسی شرایط خروج: {str(e)}")
            return {'exit': False}
