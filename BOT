import sqlite3
import time
import os
import logging
from datetime import datetime, timedelta

logger = logging.getLogger(__name__)

class DatabaseHandler:
    """کلاس مدیریت دیتابیس"""
    def __init__(self, db_path):
        """مقداردهی اولیه با مسیر فایل دیتابیس"""
        self.db_path = db_path
        # ایجاد دایرکتوری دیتابیس در صورت عدم وجود
        db_dir = os.path.dirname(db_path)
        if db_dir and not os.path.exists(db_dir):
            os.makedirs(db_dir)
        # ایجاد جداول دیتابیس
        self.init_db()

    def get_connection(self):
        """ایجاد و برگرداندن یک اتصال به دیتابیس"""
        conn = sqlite3.connect(self.db_path)
        conn.row_factory = sqlite3.Row
        return conn

    def init_db(self):
        """ایجاد جداول دیتابیس اگر وجود ندارند"""
        conn = None
        try:
            conn = self.get_connection()
            cursor = conn.cursor()
            # جدول معاملات
            cursor.execute('''
            CREATE TABLE IF NOT EXISTS trades (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                symbol TEXT NOT NULL,
                order_id TEXT,
                side TEXT NOT NULL,
                entry_price REAL NOT NULL,
                exit_price REAL DEFAULT NULL,
                quantity REAL NOT NULL,
                entry_time TIMESTAMP NOT NULL,
                exit_time TIMESTAMP DEFAULT NULL,
                stop_loss REAL NOT NULL,
                take_profit REAL NOT NULL,
                status TEXT NOT NULL,
                profit_loss REAL DEFAULT NULL,
                strategy TEXT,
                notes TEXT
            )
            ''')
            # جدول سیگنال‌ها
            cursor.execute('''
            CREATE TABLE IF NOT EXISTS signals (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                symbol TEXT NOT NULL,
                side TEXT NOT NULL,
                price REAL NOT NULL,
                time TIMESTAMP NOT NULL,
                strategy TEXT NOT NULL,
                indicators TEXT NOT NULL,
                executed BOOLEAN DEFAULT 0,
                notes TEXT
            )
            ''')
            # جدول تنظیمات
            cursor.execute('''
            CREATE TABLE IF NOT EXISTS settings (
                key TEXT PRIMARY KEY,
                value TEXT NOT NULL,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
            ''')
            # جدول داده‌های بازار
            cursor.execute('''
            CREATE TABLE IF NOT EXISTS market_data (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                symbol TEXT NOT NULL,
                timeframe TEXT NOT NULL,
                open REAL NOT NULL,
                high REAL NOT NULL,
                low REAL NOT NULL,
                close REAL NOT NULL,
                volume REAL NOT NULL,
                timestamp TIMESTAMP NOT NULL,
                UNIQUE(symbol, timeframe, timestamp)
            )
            ''')
            conn.commit()
            logger.info("جداول دیتابیس با موفقیت ایجاد شدند")
        except Exception as e:
            logger.error(f"خطا در ایجاد جداول دیتابیس: {str(e)}")
        finally:
            if conn:
                conn.close()

    def add_trade(self, symbol, order_id, side, entry_price, quantity, stop_loss, take_profit, status='OPEN'):
        """افزودن معامله جدید به دیتابیس"""
        try:
            conn = self.get_connection()
            cursor = conn.cursor()
            # زمان فعلی به عنوان زمان ورود
            entry_time = int(time.time())
            query = """
            INSERT INTO trades (
                symbol, order_id, side, entry_price, quantity, 
                stop_loss, take_profit, entry_time, status
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """
            cursor.execute(query, (
                symbol, order_id, side, entry_price, quantity,
                stop_loss, take_profit, entry_time, status
            ))
            conn.commit()
            trade_id = cursor.lastrowid
            conn.close()
            logger.info(f"معامله جدید با شناسه {trade_id} در دیتابیس ثبت شد")
            return trade_id
        except Exception as e:
            logger.error(f"خطا در افزودن معامله به دیتابیس: {str(e)}")
            return None

    def update_trade_status(self, trade_id, status, exit_price=None):
        """بروزرسانی وضعیت معامله در دیتابیس"""
        try:
            conn = self.get_connection()
            cursor = conn.cursor()
            # زمان فعلی به عنوان زمان خروج
            exit_time = int(time.time()) if status in ['CLOSED', 'STOPPED'] else None
            if exit_price and exit_time:
                query = """
                UPDATE trades 
                SET status = ?, exit_price = ?, exit_time = ? 
                WHERE id = ?
                """
                cursor.execute(query, (status, exit_price, exit_time, trade_id))
            else:
                query = """
                UPDATE trades 
                SET status = ? 
                WHERE id = ?
                """
                cursor.execute(query, (status, trade_id))
            conn.commit()
            conn.close()
            logger.info(f"وضعیت معامله با شناسه {trade_id} به {status} تغییر یافت")
            return True
        except Exception as e:
            logger.error(f"خطا در بروزرسانی وضعیت معامله: {str(e)}")
            return False

    def get_trade(self, trade_id):
        """دریافت اطلاعات یک معامله خاص"""
        try:
            conn = self.get_connection()
            cursor = conn.cursor()
            query = "SELECT * FROM trades WHERE id = ?"
            cursor.execute(query, (trade_id,))
            trade = cursor.fetchone()
            conn.close()
            if trade:
                return dict(trade)
            else:
                return None
        except Exception as e:
            logger.error(f"خطا در دریافت اطلاعات معامله: {str(e)}")
            return None

    def get_open_trades(self, symbol=None):
        """دریافت لیست معاملات باز"""
        try:
            conn = self.get_connection()
            cursor = conn.cursor()
            if symbol:
                query = """
                SELECT * FROM trades 
                WHERE status = 'OPEN' AND symbol = ? 
                ORDER BY entry_time DESC
                """
                cursor.execute(query, (symbol,))
            else:
                query = """
                SELECT * FROM trades 
                WHERE status = 'OPEN' 
                ORDER BY entry_time DESC
                """
                cursor.execute(query)
            trades = [dict(row) for row in cursor.fetchall()]
            conn.close()
            return trades
        except Exception as e:
            logger.error(f"خطا در دریافت معاملات باز: {str(e)}")
            return []

    def get_total_profit(self):
        """کل سود/زیان را برمی‌گرداند"""
        conn = None
        try:
            conn = self.get_connection()
            cursor = conn.cursor()
            query = '''
            SELECT SUM(profit_loss) as total_profit FROM trades 
            WHERE status = 'CLOSED'
            '''
            cursor.execute(query)
            result = cursor.fetchone()
            if result and result['total_profit'] is not None:
                return float(result['total_profit'])
            else:
                return 0.0
        except Exception as e:
            logger.error(f"خطا در محاسبه کل سود/زیان: {str(e)}")
            return 0.0
        finally:
            if conn:
                conn.close()

    def get_daily_profit(self):
        """سود/زیان روز جاری را برمی‌گرداند"""
        conn = None
        try:
            conn = self.get_connection()
            cursor = conn.cursor()
            # محاسبه شروع روز جاری
            today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
            start_of_day = int(today.timestamp())
            query = '''
            SELECT SUM(profit_loss) as daily_profit FROM trades 
            WHERE status = 'CLOSED' AND exit_time >= ?
            '''
            cursor.execute(query, (start_of_day,))
            result = cursor.fetchone()
            if result and result['daily_profit'] is not None:
                return float(result['daily_profit'])
            else:
                return 0.0
        except Exception as e:
            logger.error(f"خطا در محاسبه سود/زیان روزانه: {str(e)}")
            return 0.0
        finally:
            if conn:
                conn.close()

    def get_daily_loss(self):
        """محاسبه مجموع ضررهای روزانه (به صورت عدد مثبت)"""
        try:
            conn = self.get_connection()
            cursor = conn.cursor()
            # محاسبه زمان شروع روز جاری (ساعت 00:00:00)
            today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
            start_of_day = int(today.timestamp())
            query = """
            SELECT 
                SUM(
                    CASE 
                        WHEN side = 'BUY' AND exit_price < entry_price THEN (entry_price - exit_price) * quantity
                        WHEN side = 'SELL' AND exit_price > entry_price THEN (exit_price - entry_price) * quantity
                        ELSE 0
                    END
                ) as daily_loss
            FROM trades
            WHERE status IN ('CLOSED', 'STOPPED') 
            AND exit_price IS NOT NULL
            AND exit_time >= ?
            """
            cursor.execute(query, (start_of_day,))
            result = cursor.fetchone()
            conn.close()
            if result and result['daily_loss'] is not None:
                return float(result['daily_loss'])
            else:
                return 0.0
        except Exception as e:
            logger.error(f"خطا در محاسبه ضرر روزانه: {str(e)}")
            return 0.0

    def get_total_trades_count(self):
        """دریافت تعداد کل معاملات"""
