import time
import logging
from datetime import datetime
from bot.risk_manager import RiskManager

logger = logging.getLogger(__name__)


class Strategy:
    """کلاس اصلی استراتژی معاملاتی"""

    def __init__(self, db, exchange, config):
        """مقداردهی اولیه با دیتابیس، صرافی و تنظیمات"""
        self.db = db
        self.exchange = exchange
        self.config = config
        self.risk_manager = RiskManager(config, db)
        self.last_check_time = 0

        # ایجاد نمونه از استراتژی RSI_ATR
        from bot.rsi_atr_strategy import RSI_ATR_Strategy
        self.strategy = RSI_ATR_Strategy(config)

    def execute(self, market_data):
        """اجرای استراتژی معاملاتی"""
        try:
            current_time = time.time()

            # بررسی معاملات باز برای خروج احتمالی
            self.check_open_trades(market_data)

            # بررسی شرایط ورود به معامله جدید (با فاصله زمانی مناسب)
            if current_time - self.last_check_time >= self.config.signal_check_interval:
                self.check_entry_signals(market_data)
                self.last_check_time = current_time

        except Exception as e:
            logger.error(f"خطا در اجرای استراتژی: {str(e)}")

    def check_entry_signals(self, market_data):
        """بررسی سیگنال‌های ورود به معامله"""
        try:
            # بررسی محدودیت‌های ریسک
            if not self.risk_manager.check_risk_limits():
                logger.info("محدودیت‌های ریسک اجازه ورود به معامله جدید را نمی‌دهند")
                return

            # دریافت سیگنال از استراتژی
            signal = self.strategy.generate_signal(market_data)

            if not signal or signal['signal'] == 'NEUTRAL':
                return

            # اطلاعات سیگنال
            signal_type = signal['signal']  # BUY یا SELL
            entry_price = signal['price']
            stop_loss = signal['stop_loss']
            take_profit = signal['take_profit']

            logger.info(
                f"سیگنال {signal_type} دریافت شد. قیمت: {entry_price}, حد ضرر: {stop_loss}, حد سود: {take_profit}")

            # محاسبه اندازه موقعیت
            position_size = self.risk_manager.calculate_position_size(entry_price, stop_loss)

            if position_size <= 0:
                logger.warning("اندازه موقعیت محاسبه شده نامعتبر است")
                return

            # ثبت سفارش
            order_id = self.exchange.place_order(
                symbol=self.config.symbol,
                side=signal_type,
                price=entry_price,
                amount=position_size,
                order_type='limit'
            )

            if not order_id:
                logger.error("خطا در ثبت سفارش")
                return

            # ثبت معامله در دیتابیس
            trade_data = {
                'symbol': self.config.symbol,
                'side': signal_type,
                'entry_price': entry_price,
                'quantity': position_size,
                'stop_loss': stop_loss,
                'take_profit': take_profit,
                'order_id': order_id
            }

            trade_id = self.db.add_trade(trade_data)

            if trade_id:
                logger.info(f"معامله جدید با شناسه {trade_id} ثبت شد")
            else:
                logger.error("خطا در ثبت معامله در دیتابیس")
                # تلاش برای لغو سفارش در صورت خطا در ثبت معامله
                self.exchange.cancel_order(order_id, self.config.symbol)

        except Exception as e:
            logger.error(f"خطا در بررسی سیگنال‌های ورود: {str(e)}")

    def check_open_trades(self, market_data):
        """بررسی معاملات باز برای خروج احتمالی"""
        try:
            # دریافت قیمت فعلی
            current_price = market_data['close'][-1]

            # دریافت معاملات باز
            open_trades = self.db.get_open_trades(self.config.symbol)

            for trade in open_trades:
                # بررسی شرایط خروج
                exit_signal = self.strategy.check_exit_conditions(trade, current_price)

                if exit_signal['exit']:
                    # خروج از معامله
                    logger.info(f"شرایط خروج برای معامله {trade['id']} فراهم شد. دلیل: {exit_signal['reason']}")

                    # ثبت سفارش خروج
                    exit_price = exit_signal['price']
                    exit_side = 'SELL' if trade['side'] == 'BUY' else 'BUY'

                    order_id = self.exchange.place_order(
                        symbol=self.config.symbol,
                        side=exit_side,
                        price=exit_price,
                        amount=trade['quantity'],
                        order_type='market'  # استفاده از سفارش بازار برای خروج سریع
                    )

                    if order_id:
                        # بستن معامله در دیتابیس
                        profit = self.db.close_trade(trade['id'], exit_price, exit_signal['reason'])

                        if profit is not None:
                            logger.info(f"معامله {trade['id']} با موفقیت بسته شد. سود/زیان: {profit:.6f}")
                        else:
                            logger.error(f"خطا در بستن معامله {trade['id']} در دیتابیس")
                    else:
                        logger.error(f"خطا در ثبت سفارش خروج برای معامله {trade['id']}")

        except Exception as e:
            logger.error(f"خطا در بررسی معاملات باز: {str(e)}")
