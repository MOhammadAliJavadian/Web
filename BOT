logger = logging.getLogger(__name__)


class RiskManager:
    """کلاس مدیریت ریسک معاملات"""

    def __init__(self, config, db):
        """مقداردهی اولیه با تنظیمات و دیتابیس"""
        self.config = config
        self.db = db

    def check_risk_limits(self):
        """بررسی محدودیت‌های ریسک"""
        try:
            # بررسی تعداد معاملات باز
            open_trades_count = self.db.get_open_trades_count()
            if open_trades_count >= self.config.max_open_trades:
                logger.info(
                    f"تعداد معاملات باز ({open_trades_count}) به حداکثر مجاز ({self.config.max_open_trades}) رسیده است")
                return False

            # بررسی ضرر روزانه
            daily_loss = self.db.get_daily_loss()
            max_daily_loss_amount = (self.config.max_daily_loss / 100) * self.config.account_balance

            if daily_loss >= max_daily_loss_amount:
                logger.info(f"ضرر روزانه ({daily_loss:.2f}) به حداکثر مجاز ({max_daily_loss_amount:.2f}) رسیده است")
                return False

            # همه شرایط ریسک برقرار هستند
            return True

        except Exception as e:
            logger.error(f"خطا در بررسی محدودیت‌های ریسک: {str(e)}")
            return False

    def calculate_position_size(self, entry_price, stop_loss):
        """محاسبه اندازه موقعیت بر اساس مدیریت ریسک"""
        try:
            # محاسبه درصد ریسک هر معامله
            risk_amount = (self.config.risk_per_trade / 100) * self.config.account_balance

            # محاسبه فاصله قیمتی تا حد ضرر
            if entry_price > stop_loss:  # معامله خرید
                price_distance = entry_price - stop_loss
                side = 'BUY'
            else:  # معامله فروش
                price_distance = stop_loss - entry_price
                side = 'SELL'

            # محاسبه درصد فاصله تا حد ضرر
            risk_percentage = abs(price_distance / entry_price)

            # محاسبه اندازه موقعیت
            position_size = risk_amount / (entry_price * risk_percentage)

            # اعمال محدودیت حداکثر اندازه موقعیت
            max_position_size = (self.config.max_position_size / 100) * self.config.account_balance / entry_price
            position_size = min(position_size, max_position_size)

            logger.info(f"اندازه موقعیت محاسبه شده: {position_size:.6f} برای معامله {side}")

            return position_size

        except Exception as e:
            logger.error(f"خطا در محاسبه اندازه موقعیت: {str(e)}")
            return 0
