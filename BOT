    def send_message(self, message):
        """ارسال پیام به کاربر"""
        try:
            self.bot.send_message(self.chat_id, message)
            return True
        except Exception as e:
            logger.error(f"خطا در ارسال پیام تلگرام: {str(e)}")
            return False

    def send_trade_notification(self, trade_data, action):
        """ارسال اعلان معامله"""
        try:
            if action == 'OPEN':
                side_emoji = "🟢" if trade_data['side'] == 'BUY' else "🔴"
                message = f"""
                {side_emoji} معامله جدید باز شد:

                نماد: {trade_data['symbol']}
                جهت: {trade_data['side']}
                قیمت ورود: {trade_data['entry_price']:.8f}
                مقدار: {trade_data['quantity']:.8f}
                حد ضرر: {trade_data['stop_loss']:.8f}
                حد سود: {trade_data['take_profit']:.8f}

                ⏰ زمان: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
                """
            elif action == 'CLOSE':
                profit_emoji = "✅" if trade_data['profit'] > 0 else "❌"
                message = f"""
                {profit_emoji} معامله بسته شد:

                نماد: {trade_data['symbol']}
                جهت: {trade_data['side']}
                قیمت ورود: {trade_data['entry_price']:.8f}
                قیمت خروج: {trade_data['exit_price']:.8f}
                سود/زیان: {trade_data['profit']:.8f} USDT
                دلیل خروج: {trade_data['exit_reason']}

                ⏰ زمان: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
                """

            self.send_message(message)
            return True
        except Exception as e:
            logger.error(f"خطا در ارسال اعلان معامله: {str(e)}")
            return False

    def start(self):
        """شروع ربات تلگرام"""
        if self.is_running:
            logger.warning("ربات تلگرام در حال اجرا است")
            return

        def run_bot():
            logger.info("ربات تلگرام شروع به کار کرد")
            self.bot.polling(none_stop=True, interval=1)

        self.bot_thread = threading.Thread(target=run_bot)
        self.bot_thread.daemon = True
        self.bot_thread.start()
        self.is_running = True

        # ارسال پیام شروع
        self.send_message("🤖 ربات معاملاتی فعال شد")

    def stop(self):
        """توقف ربات تلگرام"""
        if not self.is_running:
            logger.warning("ربات تلگرام در حال اجرا نیست")
            return

        self.bot.stop_polling()
        self.is_running = False
        logger.info("ربات تلگرام متوقف شد")

        # ارسال پیام توقف
        self.send_message("🛑 ربات معاملاتی متوقف شد")
