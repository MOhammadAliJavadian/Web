            return False
        except Exception as e:
            logger.error(f"خطا در بررسی اتصال به صرافی: {str(e)}")
            # چاپ جزئیات بیشتر خطا
            import traceback
            traceback.print_exc()
            return False

    def get_symbols(self):
        """دریافت لیست نمادهای معاملاتی"""
        try:
            response = requests.get('https://api.coinex.com/v1/market/list')
            if response.status_code == 200:
                data = response.json()
                if data['code'] == 0:
                    print("Available symbols:", data['data'])
                    return data['data']
            return None
        except Exception as e:
            logger.error(f"خطا در دریافت لیست نمادها: {str(e)}")
            return None

    def get_klines(self, market_symbol, interval='1hour', limit=100):
        """دریافت کندل‌استیک‌های بازار"""
        try:
            # اصلاح URL با حذف اسلش اضافی
            url = f"{self.base_url}/market/kline"
            params = {
                'market': market_symbol,
                'type': interval,
                'limit': limit
            }
            response = requests.get(url, params=params)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            logging.error(f"خطا در ارتباط با API: {e}")
            return None

    def _convert_timeframe(self, timeframe):
        """تبدیل تایم‌فریم به فرمت مورد نیاز API"""
        # بررسی فرمت صحیح تایم‌فریم برای Coinex
        # مثال: 1min, 5min, 15min, 30min, 1hour, 2hour, 4hour, 6hour, 12hour, 1day, 3day, 1week
