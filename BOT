    def close(self):
        """بستن اتصال به دیتابیس"""
        # در SQLite نیازی به بستن اتصال نیست، اما این متد برای سازگاری با سایر دیتابیس‌ها ایجاد شده است
        pass

    def save_setting(self, key, value):
        """ذخیره یک تنظیم در دیتابیس"""
        try:
            conn = self.get_connection()
            cursor = conn.cursor()
            query = """
            INSERT OR REPLACE INTO settings (key, value)
            VALUES (?, ?)
            """
            cursor.execute(query, (key, str(value)))
            conn.commit()
            conn.close()
            logger.debug(f"تنظیم {key} با مقدار {value} ذخیره شد")
            return True
        except Exception as e:
            logger.error(f"خطا در ذخیره تنظیم: {str(e)}")
            return False

        def get_setting(self, key, default=None):
            """دریافت یک تنظیم از دیتابیس"""
