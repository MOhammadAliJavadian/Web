                        COUNT(*) as total_trades,
                        SUM(CASE WHEN 
                            (side = 'BUY' AND exit_price > entry_price) OR 
                            (side = 'SELL' AND exit_price < entry_price) 
                            THEN 1 ELSE 0 END) as winning_trades,
                        SUM(CASE 
                            WHEN side = 'BUY' THEN (exit_price - entry_price) * quantity
                            WHEN side = 'SELL' THEN (entry_price - exit_price) * quantity
                            ELSE 0 END) as total_profit
                    FROM trades
                    WHERE status IN ('CLOSED', 'STOPPED') 
                    AND exit_price IS NOT NULL
                    {time_filter}
                    GROUP BY symbol
                    ORDER BY total_profit DESC
                    """
                cursor.execute(query, params)
                symbol_stats = [dict(row) for row in cursor.fetchall()]
                conn.close()

                # تبدیل به دیکشنری نتیجه
