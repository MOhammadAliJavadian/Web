import time
import hmac
import json
import hashlib
import logging
import requests
import numpy as np
from urllib.parse import urlencode
from datetime import datetime

logger = logging.getLogger(__name__)


class CoinexAPI:
    """کلاس ارتباط با API صرافی Coinex"""

    def __init__(self, api_key, api_secret):
        """مقداردهی اولیه با کلیدهای API"""
        self.api_key = api_key
        self.api_secret = api_secret
        self.base_url = "https://api.coinex.com/v1"
        self.session = self._init_session()

    def _init_session(self):
        """ایجاد و تنظیم نشست HTTP"""
        session = requests.Session()
        session.headers.update({
            'User-Agent': 'CoinexTradingBot/1.0',
            'Content-Type': 'application/json',
            'Connection': 'keep-alive',
        })
        return session

    def _generate_signature(self, params):
        """تولید امضای درخواست"""
        # مرتب‌سازی پارامترها بر اساس کلید
        sorted_params = sorted(params.items())
        # تبدیل به رشته
        data = urlencode(sorted_params)
        # امضای HMAC
        signature = hmac.new(
            self.api_secret.encode('utf-8'),
            data.encode('utf-8'),
            hashlib.md5
        ).hexdigest()
        return signature

    def _request(self, method, endpoint, params=None, auth=False):
        """ارسال درخواست به API"""
        url = f"{self.base_url}{endpoint}"

        # افزودن پارامترهای عمومی
        if params is None:
            params = {}

        if auth:
            # افزودن پارامترهای احراز هویت
            params['access_id'] = self.api_key
            params['tonce'] = int(time.time() * 1000)
            # تولید امضا
            signature = self._generate_signature(params)
            # افزودن امضا به هدرها
            self.session.headers.update({'authorization': signature})

        try:
            # ارسال درخواست
            if method == 'GET':
                response = self.session.get(url, params=params, timeout=10)
            elif method == 'POST':
                response = self.session.post(url, json=params, timeout=10)
            else:
                raise ValueError(f"روش HTTP نامعتبر: {method}")

            # بررسی کد وضعیت
            response.raise_for_status()

            # تبدیل پاسخ به JSON
            data = response.json()

            # بررسی کد وضعیت API
            if data.get('code') != 0:
                logger.error(f"خطای API: {data.get('message')}")
                return None

            return data.get('data')

        except requests.exceptions.RequestException as e:
            logger.error(f"خطا در ارتباط با API: {str(e)}")
            return None

    def get_market_data(self, symbol, timeframe):
        """دریافت داده‌های بازار در فرمت سازگار با TA-Lib"""
        try:
            # تبدیل تایم‌فریم به فرمت مورد نیاز API
            interval_map = {
                '1m': '1min', '5m': '5min', '15m': '15min', '30m': '30min',
                '1h': '1hour', '2h': '2hour', '4h': '4hour', '6h': '6hour',
                '12h': '12hour', '1d': '1day', '3d': '3day', '1w': '1week'
            }
            interval = interval_map.get(timeframe, '1hour')

            # دریافت کندل‌ها
            params = {
                'market': symbol,
                'type': interval,
                'limit': 100  # تعداد کندل‌های درخواستی
            }

            response = self._request('GET', '/market/kline', params)

            if not response:
                logger.error(f"داده‌ای برای {symbol} با تایم‌فریم {timeframe} دریافت نشد")
                return None

            # تبدیل داده‌ها به فرمت مناسب
            candles = []
            for candle in response:
                candles.append({
                    'timestamp': int(candle[0]),
                    'open': float(candle[1]),
                    'high': float(candle[2]),
                    'low': float(candle[3]),
                    'close': float(candle[4]),
                    'volume': float(candle[5])
                })

            # مرتب‌سازی بر اساس زمان (صعودی)
            candles.sort(key=lambda x: x['timestamp'])

            # بررسی تعداد کافی داده
            if len(candles) < 10:
                logger.warning(f"تعداد کندل‌های دریافتی برای {symbol} کافی نیست: {len(candles)}")
                return None

            # تبدیل به آرایه‌های NumPy برای استفاده در TA-Lib
            result = {
                'timestamp': np.array([c['timestamp'] for c in candles], dtype=np.int64),
                'open': np.array([c['open'] for c in candles], dtype=np.float64),
                'high': np.array([c['high'] for c in candles], dtype=np.float64),
                'low': np.array([c['low'] for c in candles], dtype=np.float64),
                'close': np.array([c['close'] for c in candles], dtype=np.float64),
                'volume': np.array([c['volume'] for c in candles], dtype=np.float64)
            }

            logger.debug(f"داده‌های بازار برای {symbol} با موفقیت دریافت شد: {len(candles)} کندل")
            return result

        except Exception as e:
            logger.error(f"خطا در دریافت داده‌های بازار برای {symbol}: {str(e)}")
            return None

    def get_balance(self):
        """دریافت موجودی حساب"""
        try:
            response = self._request('GET', '/balance/info', auth=True)
            if not response:
                return 0

            # استخراج موجودی USDT
            usdt_balance = float(response.get('USDT', {}).get('available', '0'))
            return usdt_balance

        except Exception as e:
            logger.error(f"خطا در دریافت موجودی حساب: {str(e)}")
            return 0

    def place_order(self, symbol, side, price, amount, order_type='limit'):
        """ثبت سفارش"""
        try:
            # تبدیل پارامترها به فرمت مورد نیاز API
            side_map = {'BUY': 'buy', 'SELL': 'sell'}
            type_map = {'limit': 'limit', 'market': 'market'}

            params = {
                'market': symbol,
                'type': side_map.get(side, 'buy'),
                'amount': str(amount),
                'price': str(price) if order_type == 'limit' else '0',
                'order_type': type_map.get(order_type, 'limit')
            }

            response = self._request('POST', '/order/limit', params, auth=True)

            if not response:
                return None

            # استخراج شناسه سفارش
            order_id = response.get('id')
            logger.info(f"سفارش با موفقیت ثبت شد. شناسه: {order_id}")

            return order_id

        except Exception as e:
            logger.error(f"خطا در ثبت سفارش: {str(e)}")
            return None

    def cancel_order(self, order_id, symbol):
        """لغو سفارش"""
        try:
            params = {
                'id': order_id,
                'market': symbol
            }

            response = self._request('POST', '/order/pending/cancel', params, auth=True)

            if not response:
                return False

            logger.info(f"سفارش با شناسه {order_id} با موفقیت لغو شد")
            return True

        except Exception as e:
            logger.error(f"خطا در لغو سفارش: {str(e)}")
            return False

    def get_order_status(self, order_id, symbol):
        """دریافت وضعیت سفارش"""
        try:
            params = {
                'id': order_id,
                'market': symbol
            }

            response = self._request('GET', '/order/status', params, auth=True)

            if not response:
                return None

            return response

        except Exception as e:
            logger.error(f"خطا در دریافت وضعیت سفارش: {str(e)}")
            return None


    def check_connection(self):
        """بررسی اتصال به صرافی"""
        try:
            # یک درخواست ساده برای بررسی اتصال
            import requests
